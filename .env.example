# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Tunnel — Environment Variable Template
#
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to version control.
#
# The DFS runs perfectly without any of these variables set —
# Cloudflare Tunnel is entirely optional.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required for cloudflared (tunnel token mode) ─────────────────────────────
#
# Obtain this token from:
#   Option A (recommended): Cloudflare Zero Trust dashboard
#     → Networks → Tunnels → Create a tunnel → copy the token shown
#   Option B: CLI
#     cloudflared tunnel create dfs-tunnel
#     # Then find the tunnel UUID in ~/.cloudflared/<UUID>.json
#     # and set credentials-file in cloudflare/config.yml instead of a token.
#
# If you use the tunnel token (Option A), `cloudflared` does not need a
# credentials JSON file — just pass the token via this env var or the
# --token flag.
CF_TUNNEL_TOKEN=

# ── Public hostname ───────────────────────────────────────────────────────────
#
# The DNS name your users will hit, e.g. dfs.yourdomain.com
# This must be a hostname that belongs to a domain managed by Cloudflare DNS.
# Run:  cloudflared tunnel route dns <TUNNEL_UUID> dfs.yourdomain.com
# to create the CNAME automatically.
CF_PUBLIC_HOSTNAME=dfs.example.com

# ── Local Coordinator address ─────────────────────────────────────────────────
#
# The address cloudflared will forward traffic to on this machine.
# Keep the default unless you changed COORDINATOR_HOST or COORDINATOR_PORT
# in config.py.
CF_COORDINATOR_URL=https://127.0.0.1:8000

# ─────────────────────────────────────────────────────────────────────────────
# These variables are NOT used by the DFS Python code.
# They are read only by:
#   - cloudflare/config.yml  (when you substitute them manually or via envsubst)
#   - scripts/verify_cloudflare.py  (the verification/test script)
# ─────────────────────────────────────────────────────────────────────────────
